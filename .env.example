# Google Sheets service account (server-only — never expose these to the
# browser). See README.md "Google Cloud project setup" for how to create
# them. Without these, the app falls back to an in-memory Sheets client
# for local development (data is lost on restart).
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_CLIENT_EMAIL=your-service-account@your-gcp-project-id.iam.gserviceaccount.com
# Paste the private key from the service account's JSON key file. On
# Vercel (and most CI env var UIs), escape newlines as \n — the app
# un-escapes them automatically. Locally you can also paste it with real
# line breaks inside the quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExampleOnly...\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-from-the-sheets-url

# Researcher/admin authentication (Auth.js). Generate a secret with:
#   openssl rand -base64 32
AUTH_SECRET=
# Google OAuth client for admin sign-in (a *different* Google Cloud
# credential from the service account above — this one is a normal OAuth
# 2.0 Web Application client). Auth.js reads these by convention.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated list of researcher emails allowed into /admin.
ADMIN_ALLOWED_EMAILS=researcher@example.com

# Test/CI only — never set these in a real deployment's environment
# variables. Together they let Playwright/CI sign in to /admin without a
# live Google OAuth flow; the bypass provider isn't registered otherwise.
ALLOW_ADMIN_TEST_LOGIN=
E2E_ADMIN_TEST_SECRET=
