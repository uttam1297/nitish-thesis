# Public — safe to expose in the browser bundle. From Supabase project
# settings -> API. RLS denies the anon/authenticated roles everything (see
# supabase/migrations), so this key alone cannot read or write research
# data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only, secret. Bypasses Row Level Security entirely — never
# expose this in client code, logs, or API responses. From Supabase
# project settings -> API -> service_role key. Without it, the app falls
# back to an in-memory repository for local development (data is lost on
# restart) — see src/lib/supabase/server-client.ts.
SUPABASE_SERVICE_ROLE_KEY=

# "main" marks new sessions as real data; anything else (including unset)
# defaults to "pilot". See PILOT_CHECKLIST.md.
STUDY_STAGE=

# Comma-separated researcher emails allowed into /admin, in addition to
# requiring a valid Supabase Auth session. Optional: if unset, any
# authenticated Supabase user is trusted (expected to be safe because
# public sign-up is disabled in the Supabase project — see README
# "Researcher authentication").
ADMIN_ALLOWED_EMAILS=researcher@example.com
